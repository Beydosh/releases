.0/System.Security.Cryptography.Pkcs.dll","Length":341816,"Sha256":"66D6FAA3933A40BE52CFE9EED4BAA3B507BB9B6CFDE99526F35992E22CCEC308"}],"Compatibility":{"Platform":"windows","Architecture":"x64","PackageFormat":"beydosh-signed-plain-v2"},"Rollback":{"Mode":"blocked","PreviousVersion":null,"PreviousManifestSha256":null},"SecurityRelevant":false,"SecuritySeverity":"none","SecurityReasonDe":"","SecurityReasonEn":"","SecurityReference":null,"PatchNotes":["Neuer Standard-Versandstandort unter Einstellungen / Shopinformationen mit Standortname, Stra\u00DFe, Postleitzahl, Ort und L\u00E4nderauswahl.","Verbindungen verwenden den gespeicherten Standard; bei Bedarf l\u00E4sst sich eine eigene Versandadresse f\u00FCr eine Verbindung speichern oder zum Standard zur\u00FCckwechseln.","Nur der best\u00E4tigte Unternehmensinhaber kann Versandadressen bearbeiten. Die Angaben bleiben nach einem Neustart erhalten und sind nach Konto, Unternehmen und Arbeitsbereich getrennt.","Gespeicherte Versandadressen k\u00F6nnen nach ausdr\u00FCcklicher Pr\u00FCfung als neuer Standort bei eBay angelegt werden. Vorhandene Standorte und ver\u00F6ffentlichte Angebote werden dabei nicht automatisch ge\u00E4ndert.","Die Versandadresse ist vorerst lokal im PIM gespeichert. Der Website-Abgleich wird separat erg\u00E4nzt; Unternehmensname und Logo behalten ihren bisherigen Abgleich.","Escape schlie\u00DFt offene Auswahllisten auch in eingebetteten Einstellungen, ohne dabei unbeabsichtigt die Seite zu verlassen."]},"KeyId":"beydosh-update-release-2026-a","SignatureBase64":"ODzPXgV0UlYIP32tRoM9LrpPfmPkQlxaM3lckNM8pme2bxmi4Y2FquFCqM8/0sPoiKGW\u002BYPPk8n2ODbzxdTsFQ=="}