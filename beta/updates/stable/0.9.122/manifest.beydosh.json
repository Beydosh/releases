.0/System.Security.Cryptography.Pkcs.dll","Length":341816,"Sha256":"66D6FAA3933A40BE52CFE9EED4BAA3B507BB9B6CFDE99526F35992E22CCEC308"}],"Compatibility":{"Platform":"windows","Architecture":"x64","PackageFormat":"beydosh-signed-plain-v2"},"Rollback":{"Mode":"blocked","PreviousVersion":null,"PreviousManifestSha256":null},"SecurityRelevant":false,"SecuritySeverity":"none","SecurityReasonDe":"","SecurityReasonEn":"","SecurityReference":null,"PatchNotes":["Beydosh PIM 0.9.122 \u00B7 Beta","Verkauf \u0026 Versand erh\u00E4lt gemeinsame Shopstandards mit gezielten Ausnahmen f\u00FCr Kan\u00E4le, Produkttypen und einzelne Produkte.","K\u00E4ufer-Versandkosten lassen sich je weiterem Artikel sowie mit kostenlosem Versand ab einer bestimmten Menge pflegen.","Fehlende eBay-Versand-, Zahlungs- und R\u00FCcknahmerichtlinien k\u00F6nnen im PIM eingerichtet werden. Die drei Reiter und eine feste Aktionsleiste bleiben erhalten.","Die Einrichtung einer eBay-Mengenaktion zeigt ihre Wirkung auf teilnehmende Richtlinien und gemeinsame Warenk\u00F6rbe. Unklare Ergebnisse werden abgeglichen und nicht automatisch erneut gesendet.","Versanddienste und Versandkostengrenzen werden anhand der tats\u00E4chlich gelesenen eBay-Vorgaben gepr\u00FCft. Identische Eintr\u00E4ge erscheinen einmal; widerspr\u00FCchliche Paketvarianten bleiben ungekl\u00E4rt.","Automatische Lieferantenaktualisierungen sch\u00FCtzen die vorhandene Produktidentit\u00E4t und stellen gel\u00F6schte Produkte nicht unbemerkt wieder her.","Unternehmensdaten und Standard-Versandadresse behalten den vorhandenen Website-Abgleich. Neue Verkaufsprofile werden derzeit lokal gepflegt.","Eine Einrichtung ver\u00F6ffentlicht kein Angebot. Offene Kanalzuordnungen bleiben sichtbar gesperrt; eine echte Ver\u00F6ffentlichung erfordert die konkrete Angebotspr\u00FCfung."]},"KeyId":"beydosh-update-release-2026-a","SignatureBase64":"bcQYK05/F05foswkyHX3jp0vVDSFzngJrQVDawTDrlh7WXyzzu28lWZFX/oZssVMqbRGm9AmQMGj3XWN2lhZZA=="}