.0/System.Security.Cryptography.Pkcs.dll","Length":341816,"Sha256":"66D6FAA3933A40BE52CFE9EED4BAA3B507BB9B6CFDE99526F35992E22CCEC308"}],"Compatibility":{"Platform":"windows","Architecture":"x64","PackageFormat":"beydosh-signed-plain-v2"},"Rollback":{"Mode":"blocked","PreviousVersion":null,"PreviousManifestSha256":null},"SecurityRelevant":false,"SecuritySeverity":"none","SecurityReasonDe":"","SecurityReasonEn":"","SecurityReference":null,"PatchNotes":["Beydosh PIM 0.9.123 \u00B7 Beta","eBay-Einrichtung","- Kompakte Schritte f\u00FCr Konto, Versandstandort, Produkte, Verkaufsbedingungen und Angebotspr\u00FCfung. Folgeschritte werden erst nach best\u00E4tigten Voraussetzungen freigegeben; erledigte Schritte bleiben erreichbar.","- Deutsche Versandgebiete ausdr\u00FCcklich aus den aktuellen eBay-Vorgaben ausw\u00E4hlen. Die Auswahl wird mit der best\u00E4tigten Versandrichtlinie gespeichert und vor sp\u00E4teren Angebots\u00FCbertragungen erneut abgeglichen.","- eBay-Vorgaben im Richtlinienfenster aktualisieren. Namen, Betr\u00E4ge und weiterhin g\u00FCltige Versanddienste bleiben erhalten; die Vorschau muss erneut gepr\u00FCft werden.","- Bei Versandkostenfreiheit ab zwei Artikeln entf\u00E4llt die zus\u00E4tzliche Eingabe f\u00FCr einen weiteren Artikel. Die passende eBay-Mengenaktion bleibt erforderlich.","- Fehlende Richtlinien-Zustimmung sperrt die \u00DCbertragung. Sicher vor dem Senden abgebrochene Pr\u00FCfungen lassen sich erneut vorbereiten; unklare \u00DCbertragungen werden abgeglichen.","Bedienung und Grundlage","- Unternehmensinformationen unter Shopinformationen: Gesch\u00E4ftsanschrift, Kontakt- und Registerangaben mit explizitem Bearbeiten, Speichern und Abbrechen. Abgleich \u00FCber das gemeinsame Unternehmensprofil; nur best\u00E4tigte Inhaber d\u00FCrfen speichern. Offene Entw\u00FCrfe bleiben bei Website-\u00C4nderungen erhalten.","- Kleinere Pr\u00FCfaktionen, feste Schrittnavigation und weiterverwendete Eingaben bei der eBay-Einrichtung.","- Produktauswahl wird wiederverwendet; versp\u00E4tete Pr\u00FCfergebnisse \u00FCberschreiben keine neueren Eingaben.","- Launcher-Wartung wird weiterhin mit dem normalen PIM-Update ausgeliefert.","Ein Update ver\u00F6ffentlicht kein Produkt und erteilt keine eBay-Verkaufsfreigabe. Vor einem Angebot bleiben aktuelle Produktdaten, Preis, Bestand, Versandbedingungen und die ausdr\u00FCckliche Ver\u00F6ffentlichung zu pr\u00FCfen."]},"KeyId":"beydosh-update-release-2026-a","SignatureBase64":"1VjQ1ORNrcOXPODgVEkaVqh06ruqUyyvvhxZ8QnpdeAIBPgMSM2lZNzL14\u002Bh3Swk/RoCM2HqHKF/uv\u002Ba\u002BwcL4A=="}