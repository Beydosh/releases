.0/System.Security.Cryptography.Pkcs.dll","Length":341816,"Sha256":"66D6FAA3933A40BE52CFE9EED4BAA3B507BB9B6CFDE99526F35992E22CCEC308"}],"Compatibility":{"Platform":"windows","Architecture":"x64","PackageFormat":"beydosh-signed-plain-v2"},"Rollback":{"Mode":"blocked","PreviousVersion":null,"PreviousManifestSha256":null},"SecurityRelevant":false,"SecuritySeverity":"none","SecurityReasonDe":"","SecurityReasonEn":"","SecurityReference":null,"PatchNotes":["Neue Skalierungseinstellungen f\u00FCr Oberfl\u00E4che, Texte und Bedienelemente.","Benachrichtigungen werden chronologisch ohne Suchfeld angezeigt; Auswahl und ungelesener Status bleiben erhalten.","Lange E-Mail-Nachrichten werden geb\u00FCndelt aufgebaut und lassen sich ohne unn\u00F6tige Teilaktualisierungen lesen.","Einheitlichere KI-Assistenten mit Reitern, besser erreichbaren Aktionen und gesch\u00FCtzten Eingaben beim Laden und Speichern.","Import- und Attributvorlagen, Kategorien, M\u00E4rkte und Verbindungseditoren reagieren zuverl\u00E4ssiger auf Speichern, Abbrechen und Fensterwechsel.","Produktdialoge unterscheiden erfolgreiche Speicherung von einem Fehler beim anschlie\u00DFenden Laden der Ansicht; erneutes Laden speichert nicht nochmals.","Variantenbearbeitung wird durch reine Hintergrund-Statusmeldungen nicht mehr unn\u00F6tig blockiert; echte Bearbeitungskonflikte bleiben gesch\u00FCtzt.","Der Produkteditor wird nach Dialog\u00E4nderungen nur einmal aktualisiert; neuere Eingaben und ihre Auswahl bleiben erhalten.","Gemeinsame Oberfl\u00E4chen- und Hintergrundbausteine verbessern Wartbarkeit und vermeiden doppelte Abl\u00E4ufe.","Der passende Launcher ist weiterhin im normalen PIM-Update enthalten."]},"KeyId":"beydosh-update-release-2026-a","SignatureBase64":"qXhY905wxbS/75Yonp7bP1FhTJ877SaCyFCVE4pQSIxVFuzTiNKknnNiK7MCBDD6IC7wTnX1Jl36tLgQpy80rQ=="}