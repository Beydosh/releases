.0/System.Security.Cryptography.Pkcs.dll","Length":341816,"Sha256":"66D6FAA3933A40BE52CFE9EED4BAA3B507BB9B6CFDE99526F35992E22CCEC308"}],"Compatibility":{"Platform":"windows","Architecture":"x64","PackageFormat":"beydosh-signed-plain-v2"},"Rollback":{"Mode":"blocked","PreviousVersion":null,"PreviousManifestSha256":null},"SecurityRelevant":false,"SecuritySeverity":"none","SecurityReasonDe":"","SecurityReasonEn":"","SecurityReference":null,"PatchNotes":["Beydosh PIM 0.9.125 \u00B7 Beta","Eine bei eBay erfolgreich angelegte Zahlungsrichtlinie wird beim Ergebnisabgleich auch dann erkannt, wenn eBay dokumentierte, wirkungslose Antwortfelder erg\u00E4nzt. Abweichende Zahlungsbedingungen bleiben gesperrt.","Eine noch ungekl\u00E4rte Versandstaffel verhindert nicht mehr das Aktualisieren der eBay-Vorgaben f\u00FCr unabh\u00E4ngige Zahlungs- und R\u00FCcknahmerichtlinien. Der Schutz vor einer doppelten \u00DCbertragung bleibt erhalten.","Bei fehlgeschlagenen Richtlinien- und Versandstaffel\u00E4nderungen zeigt PIM vorhandene HTTP- und numerische eBay-Fehlercodes an, ohne Zugangsdaten oder vollst\u00E4ndige Anbieterantworten auszugeben.","Enth\u00E4lt den vollst\u00E4ndigen Stand von 0.9.124 einschlie\u00DFlich Artikelpreis-/Versandvorschau und Launcher-Aktualisierung im normalen PIM-Update.","Das Update allein legt keine Richtlinien an, \u00E4ndert keine Kontoeinstellungen und ver\u00F6ffentlicht keine Angebote. Die erfolgreiche Einrichtung einer Versandstaffel ist dadurch noch nicht best\u00E4tigt."]},"KeyId":"beydosh-update-release-2026-a","SignatureBase64":"GgBBNpO107TZupDiC9rd/sUkkupqkPKdPALxp9tXqc0pVFztG4ZE8pH96d1wlKNK13IVuK/IBUI8c3RopJMh3Q=="}